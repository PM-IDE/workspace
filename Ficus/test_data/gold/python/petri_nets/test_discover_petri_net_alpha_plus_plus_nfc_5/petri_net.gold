<pnml>
  <net>
    <place id="({ARTIFICIAL_START}, {A})">
    </place>
    <place id="({A}, {B})">
    </place>
    <place id="({A}, {C,D})">
    </place>
    <place id="({B}, {C,E})">
    </place>
    <place id="({C,E}, {ARTIFICIAL_END})">
    </place>
    <place id="({D}, {E})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{({ARTIFICIAL_START}, {A})}--{A}]" source="({ARTIFICIAL_START}, {A})" target="A">
    </arc>
    <arc id="[{({A}, {B})}--{B}]" source="({A}, {B})" target="B">
    </arc>
    <arc id="[{({A}, {C,D})}--{C}]" source="({A}, {C,D})" target="C">
    </arc>
    <arc id="[{({A}, {C,D})}--{D}]" source="({A}, {C,D})" target="D">
    </arc>
    <arc id="[{({B}, {C,E})}--{C}]" source="({B}, {C,E})" target="C">
    </arc>
    <arc id="[{({B}, {C,E})}--{E}]" source="({B}, {C,E})" target="E">
    </arc>
    <arc id="[{({C,E}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]" source="({C,E}, {ARTIFICIAL_END})" target="ARTIFICIAL_END">
    </arc>
    <arc id="[{({D}, {E})}--{E}]" source="({D}, {E})" target="E">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A})}]" source="ARTIFICIAL_START" target="({ARTIFICIAL_START}, {A})">
    </arc>
    <arc id="[{A}--{({A}, {B})}]" source="A" target="({A}, {B})">
    </arc>
    <arc id="[{A}--{({A}, {C,D})}]" source="A" target="({A}, {C,D})">
    </arc>
    <arc id="[{B}--{({B}, {C,E})}]" source="B" target="({B}, {C,E})">
    </arc>
    <arc id="[{C}--{({C,E}, {ARTIFICIAL_END})}]" source="C" target="({C,E}, {ARTIFICIAL_END})">
    </arc>
    <arc id="[{D}--{({D}, {E})}]" source="D" target="({D}, {E})">
    </arc>
    <arc id="[{E}--{({C,E}, {ARTIFICIAL_END})}]" source="E" target="({C,E}, {ARTIFICIAL_END})">
    </arc>
  </net>
</pnml>