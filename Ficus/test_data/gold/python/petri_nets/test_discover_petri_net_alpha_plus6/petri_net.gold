<pnml>
  <net>
    <place id="({ARTIFICIAL_START}, {A})">
    </place>
    <place id="({A}, {B})">
    </place>
    <place id="({A}, {E})">
    </place>
    <place id="({B,E}, {D,E})">
    </place>
    <place id="({B}, {E})">
    </place>
    <place id="({D}, {ARTIFICIAL_END})">
    </place>
    <place id="({E}, {D})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{({ARTIFICIAL_START}, {A})}--{A}]" source="({ARTIFICIAL_START}, {A})" target="A">
    </arc>
    <arc id="[{({A}, {B})}--{B}]" source="({A}, {B})" target="B">
    </arc>
    <arc id="[{({A}, {E})}--{E}]" source="({A}, {E})" target="E">
    </arc>
    <arc id="[{({B,E}, {D,E})}--{C}]" source="({B,E}, {D,E})" target="C">
    </arc>
    <arc id="[{({B}, {E})}--{E}]" source="({B}, {E})" target="E">
    </arc>
    <arc id="[{({D}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]" source="({D}, {ARTIFICIAL_END})" target="ARTIFICIAL_END">
    </arc>
    <arc id="[{({E}, {D})}--{D}]" source="({E}, {D})" target="D">
    </arc>
    <arc id="[{ARTIFICIAL_END}--{EndPlace}]" source="ARTIFICIAL_END" target="EndPlace">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A})}]" source="ARTIFICIAL_START" target="({ARTIFICIAL_START}, {A})">
    </arc>
    <arc id="[{A}--{({A}, {B})}]" source="A" target="({A}, {B})">
    </arc>
    <arc id="[{A}--{({A}, {E})}]" source="A" target="({A}, {E})">
    </arc>
    <arc id="[{B}--{({B}, {E})}]" source="B" target="({B}, {E})">
    </arc>
    <arc id="[{C}--{({B,E}, {D,E})}]" source="C" target="({B,E}, {D,E})">
    </arc>
    <arc id="[{D}--{({D}, {ARTIFICIAL_END})}]" source="D" target="({D}, {ARTIFICIAL_END})">
    </arc>
    <arc id="[{E}--{({E}, {D})}]" source="E" target="({E}, {D})">
    </arc>
    <arc id="[{StartPlace}--{ARTIFICIAL_START}]" source="StartPlace" target="ARTIFICIAL_START">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>