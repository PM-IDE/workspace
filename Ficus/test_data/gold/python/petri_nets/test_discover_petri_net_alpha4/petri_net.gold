<pnml>
  <net>
    <place id="({ARTIFICIAL_START}, {A,E})">
    </place>
    <place id="({A}, {B})">
    </place>
    <place id="({A}, {C})">
    </place>
    <place id="({B}, {D})">
    </place>
    <place id="({C}, {D})">
    </place>
    <place id="({D,F}, {ARTIFICIAL_END})">
    </place>
    <place id="({E}, {F})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <arc id="[{({ARTIFICIAL_START}, {A,E})}--{A}]">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,E})}--{E}]">
    </arc>
    <arc id="[{({A}, {B})}--{B}]">
    </arc>
    <arc id="[{({A}, {C})}--{C}]">
    </arc>
    <arc id="[{({B}, {D})}--{D}]">
    </arc>
    <arc id="[{({C}, {D})}--{D}]">
    </arc>
    <arc id="[{({D,F}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]">
    </arc>
    <arc id="[{({E}, {F})}--{F}]">
    </arc>
    <arc id="[{ARTIFICIAL_END}--{EndPlace}]">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A,E})}]">
    </arc>
    <arc id="[{A}--{({A}, {B})}]">
    </arc>
    <arc id="[{A}--{({A}, {C})}]">
    </arc>
    <arc id="[{B}--{({B}, {D})}]">
    </arc>
    <arc id="[{C}--{({C}, {D})}]">
    </arc>
    <arc id="[{D}--{({D,F}, {ARTIFICIAL_END})}]">
    </arc>
    <arc id="[{E}--{({E}, {F})}]">
    </arc>
    <arc id="[{F}--{({D,F}, {ARTIFICIAL_END})}]">
    </arc>
    <arc id="[{StartPlace}--{ARTIFICIAL_START}]">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>