<pnml>
  <net>
    <place id="({ARTIFICIAL_START}, {A})">
    </place>
    <place id="({A}, {B})">
    </place>
    <place id="({B}, {C})">
    </place>
    <place id="({C}, {ARTIFICIAL_END})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <arc id="[{({ARTIFICIAL_START}, {A})}--{A}]">
    </arc>
    <arc id="[{({A}, {B})}--{B}]">
    </arc>
    <arc id="[{({B}, {C})}--{C}]">
    </arc>
    <arc id="[{({C}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]">
    </arc>
    <arc id="[{ARTIFICIAL_END}--{EndPlace}]">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A})}]">
    </arc>
    <arc id="[{A}--{({A}, {B})}]">
    </arc>
    <arc id="[{B}--{({B}, {C})}]">
    </arc>
    <arc id="[{C}--{({C}, {ARTIFICIAL_END})}]">
    </arc>
    <arc id="[{StartPlace}--{ARTIFICIAL_START}]">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>