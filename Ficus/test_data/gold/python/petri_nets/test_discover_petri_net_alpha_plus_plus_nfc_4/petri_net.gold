<pnml>
  <net>
    <place id="({A,B}, {C})">
    </place>
    <place id="({ARTIFICIAL_START}, {A,B})">
    </place>
    <place id="({A}, {D,F})">
    </place>
    <place id="({B,F}, {E})">
    </place>
    <place id="({C}, {D,E})">
    </place>
    <place id="({D,E}, {ARTIFICIAL_END})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <arc id="[{({A,B}, {C})}--{C}]">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,B})}--{A}]">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,B})}--{B}]">
    </arc>
    <arc id="[{({A}, {D,F})}--{D}]">
    </arc>
    <arc id="[{({A}, {D,F})}--{F}]">
    </arc>
    <arc id="[{({B,F}, {E})}--{E}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{D}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{E}]">
    </arc>
    <arc id="[{({D,E}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A,B})}]">
    </arc>
    <arc id="[{A}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{A}--{({A}, {D,F})}]">
    </arc>
    <arc id="[{B}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{B}--{({B,F}, {E})}]">
    </arc>
    <arc id="[{C}--{({C}, {D,E})}]">
    </arc>
    <arc id="[{D}--{({D,E}, {ARTIFICIAL_END})}]">
    </arc>
    <arc id="[{E}--{({D,E}, {ARTIFICIAL_END})}]">
    </arc>
    <arc id="[{F}--{({B,F}, {E})}]">
    </arc>
  </net>
</pnml>