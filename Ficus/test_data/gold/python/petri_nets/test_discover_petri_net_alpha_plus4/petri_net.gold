<pnml>
  <net>
    <place id="({ARTIFICIAL_START}, {A,E})">
    </place>
    <place id="({A}, {B})">
    </place>
    <place id="({A}, {C})">
    </place>
    <place id="({B}, {D})">
    </place>
    <place id="({C}, {D})">
    </place>
    <place id="({D,F}, {ARTIFICIAL_END})">
    </place>
    <place id="({E}, {F})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <arc id="[{({ARTIFICIAL_START}, {A,E})}--{A}]" source="({ARTIFICIAL_START}, {A,E})" target="A">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,E})}--{E}]" source="({ARTIFICIAL_START}, {A,E})" target="E">
    </arc>
    <arc id="[{({A}, {B})}--{B}]" source="({A}, {B})" target="B">
    </arc>
    <arc id="[{({A}, {C})}--{C}]" source="({A}, {C})" target="C">
    </arc>
    <arc id="[{({B}, {D})}--{D}]" source="({B}, {D})" target="D">
    </arc>
    <arc id="[{({C}, {D})}--{D}]" source="({C}, {D})" target="D">
    </arc>
    <arc id="[{({D,F}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]" source="({D,F}, {ARTIFICIAL_END})" target="ARTIFICIAL_END">
    </arc>
    <arc id="[{({E}, {F})}--{F}]" source="({E}, {F})" target="F">
    </arc>
    <arc id="[{ARTIFICIAL_END}--{EndPlace}]" source="ARTIFICIAL_END" target="EndPlace">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A,E})}]" source="ARTIFICIAL_START" target="({ARTIFICIAL_START}, {A,E})">
    </arc>
    <arc id="[{A}--{({A}, {B})}]" source="A" target="({A}, {B})">
    </arc>
    <arc id="[{A}--{({A}, {C})}]" source="A" target="({A}, {C})">
    </arc>
    <arc id="[{B}--{({B}, {D})}]" source="B" target="({B}, {D})">
    </arc>
    <arc id="[{C}--{({C}, {D})}]" source="C" target="({C}, {D})">
    </arc>
    <arc id="[{D}--{({D,F}, {ARTIFICIAL_END})}]" source="D" target="({D,F}, {ARTIFICIAL_END})">
    </arc>
    <arc id="[{E}--{({E}, {F})}]" source="E" target="({E}, {F})">
    </arc>
    <arc id="[{F}--{({D,F}, {ARTIFICIAL_END})}]" source="F" target="({D,F}, {ARTIFICIAL_END})">
    </arc>
    <arc id="[{StartPlace}--{ARTIFICIAL_START}]" source="StartPlace" target="ARTIFICIAL_START">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>