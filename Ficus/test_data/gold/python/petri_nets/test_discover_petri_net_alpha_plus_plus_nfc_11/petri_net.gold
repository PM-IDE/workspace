<pnml>
  <net>
    <place id="({A,B}, {C})">
    </place>
    <place id="({ARTIFICIAL_START}, {A,B})">
    </place>
    <place id="({A}, {E})">
    </place>
    <place id="({A}, {G})">
    </place>
    <place id="({B}, {F})">
    </place>
    <place id="({C}, {D})">
    </place>
    <place id="({C}, {F,G})">
    </place>
    <place id="({D}, {E,F})">
    </place>
    <place id="({E,F}, {H})">
    </place>
    <place id="({F,G}, {H})">
    </place>
    <place id="({H}, {ARTIFICIAL_END})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <transition id="G">
      <name>
        <text>G</text>
      </name>
    </transition>
    <transition id="H">
      <name>
        <text>H</text>
      </name>
    </transition>
    <arc id="[{({A,B}, {C})}--{C}]">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,B})}--{A}]">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A,B})}--{B}]">
    </arc>
    <arc id="[{({A}, {E})}--{E}]">
    </arc>
    <arc id="[{({A}, {G})}--{G}]">
    </arc>
    <arc id="[{({B}, {F})}--{F}]">
    </arc>
    <arc id="[{({C}, {D})}--{D}]">
    </arc>
    <arc id="[{({C}, {F,G})}--{F}]">
    </arc>
    <arc id="[{({C}, {F,G})}--{G}]">
    </arc>
    <arc id="[{({D}, {E,F})}--{E}]">
    </arc>
    <arc id="[{({D}, {E,F})}--{F}]">
    </arc>
    <arc id="[{({E,F}, {H})}--{H}]">
    </arc>
    <arc id="[{({F,G}, {H})}--{H}]">
    </arc>
    <arc id="[{({H}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A,B})}]">
    </arc>
    <arc id="[{A}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{A}--{({A}, {E})}]">
    </arc>
    <arc id="[{A}--{({A}, {G})}]">
    </arc>
    <arc id="[{B}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{B}--{({B}, {F})}]">
    </arc>
    <arc id="[{C}--{({C}, {D})}]">
    </arc>
    <arc id="[{C}--{({C}, {F,G})}]">
    </arc>
    <arc id="[{D}--{({D}, {E,F})}]">
    </arc>
    <arc id="[{E}--{({E,F}, {H})}]">
    </arc>
    <arc id="[{F}--{({E,F}, {H})}]">
    </arc>
    <arc id="[{F}--{({F,G}, {H})}]">
    </arc>
    <arc id="[{G}--{({F,G}, {H})}]">
    </arc>
    <arc id="[{H}--{({H}, {ARTIFICIAL_END})}]">
    </arc>
  </net>
