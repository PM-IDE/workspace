<pnml>
  <net>
    <place id="({A,D}, {B})">
    </place>
    <place id="({ARTIFICIAL_START}, {A})">
    </place>
    <place id="({B}, {C,D})">
    </place>
    <place id="({C}, {ARTIFICIAL_END})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_END">
      <name>
        <text>ARTIFICIAL_END</text>
      </name>
    </transition>
    <transition id="ARTIFICIAL_START">
      <name>
        <text>ARTIFICIAL_START</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <arc id="[{({A,D}, {B})}--{B}]" source="({A,D}, {B})" target="B">
    </arc>
    <arc id="[{({ARTIFICIAL_START}, {A})}--{A}]" source="({ARTIFICIAL_START}, {A})" target="A">
    </arc>
    <arc id="[{({B}, {C,D})}--{C}]" source="({B}, {C,D})" target="C">
    </arc>
    <arc id="[{({B}, {C,D})}--{D}]" source="({B}, {C,D})" target="D">
    </arc>
    <arc id="[{({C}, {ARTIFICIAL_END})}--{ARTIFICIAL_END}]" source="({C}, {ARTIFICIAL_END})" target="ARTIFICIAL_END">
    </arc>
    <arc id="[{ARTIFICIAL_END}--{EndPlace}]" source="ARTIFICIAL_END" target="EndPlace">
    </arc>
    <arc id="[{ARTIFICIAL_START}--{({ARTIFICIAL_START}, {A})}]" source="ARTIFICIAL_START" target="({ARTIFICIAL_START}, {A})">
    </arc>
    <arc id="[{A}--{({A,D}, {B})}]" source="A" target="({A,D}, {B})">
    </arc>
    <arc id="[{B}--{({B}, {C,D})}]" source="B" target="({B}, {C,D})">
    </arc>
    <arc id="[{C}--{({C}, {ARTIFICIAL_END})}]" source="C" target="({C}, {ARTIFICIAL_END})">
    </arc>
    <arc id="[{D}--{({A,D}, {B})}]" source="D" target="({A,D}, {B})">
    </arc>
    <arc id="[{StartPlace}--{ARTIFICIAL_START}]" source="StartPlace" target="ARTIFICIAL_START">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>