<pnml>
  <net>
    <place id="({A,B}, {C})">
    </place>
    <place id="({A}, {E})">
    </place>
    <place id="({B}, {D})">
    </place>
    <place id="({C}, {D,E})">
    </place>
    <place id="({E}, {B})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{({A,B}, {C})}--{C}]" source="({A,B}, {C})" target="C">
    </arc>
    <arc id="[{({A}, {E})}--{E}]" source="({A}, {E})" target="E">
    </arc>
    <arc id="[{({B}, {D})}--{D}]" source="({B}, {D})" target="D">
    </arc>
    <arc id="[{({C}, {D,E})}--{D}]" source="({C}, {D,E})" target="D">
    </arc>
    <arc id="[{({C}, {D,E})}--{E}]" source="({C}, {D,E})" target="E">
    </arc>
    <arc id="[{({E}, {B})}--{B}]" source="({E}, {B})" target="B">
    </arc>
    <arc id="[{A}--{({A,B}, {C})}]" source="A" target="({A,B}, {C})">
    </arc>
    <arc id="[{A}--{({A}, {E})}]" source="A" target="({A}, {E})">
    </arc>
    <arc id="[{B}--{({A,B}, {C})}]" source="B" target="({A,B}, {C})">
    </arc>
    <arc id="[{B}--{({B}, {D})}]" source="B" target="({B}, {D})">
    </arc>
    <arc id="[{C}--{({C}, {D,E})}]" source="C" target="({C}, {D,E})">
    </arc>
    <arc id="[{E}--{({E}, {B})}]" source="E" target="({E}, {B})">
    </arc>
  </net>
</pnml>