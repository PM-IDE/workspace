<pnml>
  <net>
    <place id="({A,B}, {C})">
    </place>
    <place id="({A}, {E})">
    </place>
    <place id="({B}, {D})">
    </place>
    <place id="({C}, {D,E})">
    </place>
    <place id="({E}, {B})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{({A,B}, {C})}--{C}]">
    </arc>
    <arc id="[{({A}, {E})}--{E}]">
    </arc>
    <arc id="[{({B}, {D})}--{D}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{D}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{E}]">
    </arc>
    <arc id="[{({E}, {B})}--{B}]">
    </arc>
    <arc id="[{A}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{A}--{({A}, {E})}]">
    </arc>
    <arc id="[{B}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{B}--{({B}, {D})}]">
    </arc>
    <arc id="[{C}--{({C}, {D,E})}]">
    </arc>
    <arc id="[{E}--{({E}, {B})}]">
    </arc>
  </net>
</pnml>