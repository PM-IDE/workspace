<pnml>
  <net>
    <place id="post_A">
    </place>
    <place id="post_B">
    </place>
    <place id="post_C">
    </place>
    <place id="post_D">
    </place>
    <place id="post_F">
    </place>
    <place id="post_G">
    </place>
    <place id="pre_C">
    </place>
    <place id="pre_F">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <transition id="G">
      <name>
        <text>G</text>
      </name>
    </transition>
    <transition id="tau">
      <name>
        <text>tau</text>
      </name>
      <toolspecific tool="ProM" version="6.4" activity="$invisible$">
      </toolspecific>
    </transition>
    <arc id="[{A}--{post_A}]" source="A" target="post_A">
    </arc>
    <arc id="[{B}--{post_B}]" source="B" target="post_B">
    </arc>
    <arc id="[{C}--{post_C}]" source="C" target="post_C">
    </arc>
    <arc id="[{D}--{post_D}]" source="D" target="post_D">
    </arc>
    <arc id="[{F}--{post_F}]" source="F" target="post_F">
    </arc>
    <arc id="[{G}--{post_G}]" source="G" target="post_G">
    </arc>
    <arc id="[{post_A}--{tau}]" source="post_A" target="tau">
    </arc>
    <arc id="[{post_B}--{G}]" source="post_B" target="G">
    </arc>
    <arc id="[{post_C}--{E}]" source="post_C" target="E">
    </arc>
    <arc id="[{post_D}--{G}]" source="post_D" target="G">
    </arc>
    <arc id="[{post_F}--{B}]" source="post_F" target="B">
    </arc>
    <arc id="[{post_F}--{D}]" source="post_F" target="D">
    </arc>
    <arc id="[{post_G}--{E}]" source="post_G" target="E">
    </arc>
    <arc id="[{pre_C}--{C}]" source="pre_C" target="C">
    </arc>
    <arc id="[{pre_F}--{F}]" source="pre_F" target="F">
    </arc>
    <arc id="[{tau}--{pre_C}]" source="tau" target="pre_C">
    </arc>
    <arc id="[{tau}--{pre_F}]" source="tau" target="pre_F">
    </arc>
  </net>
</pnml>