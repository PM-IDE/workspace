<pnml>
  <net id="petri_net" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <place id="IN_END">
    </place>
    <place id="IN_START">
    </place>
    <place id="OUT_END">
    </place>
    <place id="OUT_START">
    </place>
    <transition id="END">
      <name>
        <text>END</text>
      </name>
    </transition>
    <transition id="START">
      <name>
        <text>START</text>
      </name>
    </transition>
    <transition id="tau_10">
      <name>
        <text>tau_1355</text>
      </name>
      <toolspecific tool="ProM" version="6.4" activity="$invisible$">
      </toolspecific>
    </transition>
    <arc id="[{END}--{OUT_END}]" source="END" target="OUT_END">
    </arc>
    <arc id="[{IN_END}--{END}]" source="IN_END" target="END">
    </arc>
    <arc id="[{IN_START}--{START}]" source="IN_START" target="START">
    </arc>
    <arc id="[{OUT_START}--{tau_10}]" source="OUT_START" target="tau_10">
    </arc>
    <arc id="[{START}--{OUT_START}]" source="START" target="OUT_START">
    </arc>
    <arc id="[{tau_10}--{IN_END}]" source="tau_10" target="IN_END">
    </arc>
  </net>
</pnml>