<pnml>
  <net>
    <place id="({A}, {B})">
    </place>
    <place id="({B}, {C})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <arc id="[{({A}, {B})}--{B}]" source="({A}, {B})" target="B">
    </arc>
    <arc id="[{({B}, {C})}--{C}]" source="({B}, {C})" target="C">
    </arc>
    <arc id="[{A}--{({A}, {B})}]" source="A" target="({A}, {B})">
    </arc>
    <arc id="[{B}--{({B}, {C})}]" source="B" target="({B}, {C})">
    </arc>
    <arc id="[{C}--{EndPlace}]" source="C" target="EndPlace">
    </arc>
    <arc id="[{StartPlace}--{A}]" source="StartPlace" target="A">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>