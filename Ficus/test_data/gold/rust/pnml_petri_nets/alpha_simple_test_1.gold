<pnml>
  <net>
    <place id="({A}, {B})">
    </place>
    <place id="({B}, {C})">
    </place>
    <place id="EndPlace">
    </place>
    <place id="StartPlace">
      <initialMarking>
        <text>1</text>
      </initialMarking>
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <arc id="[{({A}, {B})}--{B}]">
    </arc>
    <arc id="[{({B}, {C})}--{C}]">
    </arc>
    <arc id="[{A}--{({A}, {B})}]">
    </arc>
    <arc id="[{B}--{({B}, {C})}]">
    </arc>
    <arc id="[{C}--{EndPlace}]">
    </arc>
    <arc id="[{StartPlace}--{A}]">
    </arc>
    <finalmarkings>
      <marking>
        <place idref="EndPlace">
          <text>1</text>
        </place>
      </marking>
    </finalmarkings>
  </net>
</pnml>