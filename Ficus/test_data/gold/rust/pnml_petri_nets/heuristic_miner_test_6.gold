<pnml>
  <net>
    <place id="post_A">
    </place>
    <place id="post_B">
    </place>
    <place id="post_C">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{A}--{post_A}]">
    </arc>
    <arc id="[{B}--{post_B}]">
    </arc>
    <arc id="[{C}--{post_C}]">
    </arc>
    <arc id="[{post_A}--{C}]">
    </arc>
    <arc id="[{post_B}--{C}]">
    </arc>
    <arc id="[{post_C}--{D}]">
    </arc>
    <arc id="[{post_C}--{E}]">
    </arc>
  </net>
</pnml>