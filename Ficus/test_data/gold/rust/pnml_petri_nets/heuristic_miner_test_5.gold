<pnml>
  <net>
    <place id="post_A">
    </place>
    <place id="post_B">
    </place>
    <place id="post_D">
    </place>
    <place id="pre_B">
    </place>
    <place id="pre_D">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="tau">
      <name>
        <text>tau</text>
      </name>
      <toolspecific tool="ProM" version="6.4" activity="$invisible$">
      </toolspecific>
    </transition>
    <arc id="[{A}--{post_A}]">
    </arc>
    <arc id="[{B}--{post_B}]">
    </arc>
    <arc id="[{D}--{post_D}]">
    </arc>
    <arc id="[{post_A}--{tau}]">
    </arc>
    <arc id="[{post_B}--{C}]">
    </arc>
    <arc id="[{post_B}--{E}]">
    </arc>
    <arc id="[{post_D}--{E}]">
    </arc>
    <arc id="[{pre_B}--{B}]">
    </arc>
    <arc id="[{pre_D}--{D}]">
    </arc>
    <arc id="[{tau}--{pre_B}]">
    </arc>
    <arc id="[{tau}--{pre_D}]">
    </arc>
  </net>
</pnml>