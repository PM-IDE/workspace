<pnml>
  <net>
    <place id="({A,B}, {C})">
    </place>
    <place id="({A}, {F})">
    </place>
    <place id="({B}, {G})">
    </place>
    <place id="({C}, {D,E})">
    </place>
    <place id="({F}, {D})">
    </place>
    <place id="({G}, {E})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <transition id="G">
      <name>
        <text>G</text>
      </name>
    </transition>
    <arc id="[{({A,B}, {C})}--{C}]">
    </arc>
    <arc id="[{({A}, {F})}--{F}]">
    </arc>
    <arc id="[{({B}, {G})}--{G}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{D}]">
    </arc>
    <arc id="[{({C}, {D,E})}--{E}]">
    </arc>
    <arc id="[{({F}, {D})}--{D}]">
    </arc>
    <arc id="[{({G}, {E})}--{E}]">
    </arc>
    <arc id="[{A}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{A}--{({A}, {F})}]">
    </arc>
    <arc id="[{B}--{({A,B}, {C})}]">
    </arc>
    <arc id="[{B}--{({B}, {G})}]">
    </arc>
    <arc id="[{C}--{({C}, {D,E})}]">
    </arc>
    <arc id="[{F}--{({F}, {D})}]">
    </arc>
    <arc id="[{G}--{({G}, {E})}]">
    </arc>
  </net>
</pnml>