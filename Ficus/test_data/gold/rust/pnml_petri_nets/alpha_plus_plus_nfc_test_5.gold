<pnml>
  <net>
    <place id="({A}, {B})">
    </place>
    <place id="({A}, {C,D})">
    </place>
    <place id="({B}, {C,E})">
    </place>
    <place id="({D}, {E})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <arc id="[{({A}, {B})}--{B}]">
    </arc>
    <arc id="[{({A}, {C,D})}--{C}]">
    </arc>
    <arc id="[{({A}, {C,D})}--{D}]">
    </arc>
    <arc id="[{({B}, {C,E})}--{C}]">
    </arc>
    <arc id="[{({B}, {C,E})}--{E}]">
    </arc>
    <arc id="[{({D}, {E})}--{E}]">
    </arc>
    <arc id="[{A}--{({A}, {B})}]">
    </arc>
    <arc id="[{A}--{({A}, {C,D})}]">
    </arc>
    <arc id="[{B}--{({B}, {C,E})}]">
    </arc>
    <arc id="[{D}--{({D}, {E})}]">
    </arc>
  </net>
</pnml>