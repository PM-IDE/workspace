    </place>
    <place id="({C}, {E,F})">
    </place>
    <place id="({E,F}, {G})">
    </place>
    <transition id="A">
      <name>
        <text>A</text>
      </name>
    </transition>
    <transition id="B">
      <name>
        <text>B</text>
      </name>
    </transition>
    <transition id="C">
      <name>
        <text>C</text>
      </name>
    </transition>
    <transition id="D">
      <name>
        <text>D</text>
      </name>
    </transition>
    <transition id="E">
      <name>
        <text>E</text>
      </name>
    </transition>
    <transition id="F">
      <name>
        <text>F</text>
      </name>
    </transition>
    <transition id="G">
      <name>
        <text>G</text>
      </name>
    </transition>
    <arc id="[{({A}, {B,C})}--{B}]">
    </arc>
    <arc id="[{({A}, {B,C})}--{C}]">
    </arc>
    <arc id="[{({B,C,D}, {D,E,F})}--{D}]">
    </arc>
    <arc id="[{({B,C,D}, {D,E,F})}--{E}]">
    </arc>
    <arc id="[{({B,C,D}, {D,E,F})}--{F}]">
