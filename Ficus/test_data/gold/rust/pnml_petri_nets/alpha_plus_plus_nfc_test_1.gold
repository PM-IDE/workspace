    <arc id="[{({B,C}, {E})}--{E}]">
    </arc>
    <arc id="[{({C}, {E,F})}--{E}]">
    </arc>
    <arc id="[{({C}, {E,F})}--{F}]">
    </arc>
    <arc id="[{({E,F}, {G})}--{G}]">
    </arc>
    <arc id="[{A}--{({A}, {B,C})}]">
    </arc>
    <arc id="[{B}--{({B,C,D}, {D,E,F})}]">
    </arc>
    <arc id="[{B}--{({B,C}, {E})}]">
    </arc>
    <arc id="[{C}--{({B,C,D}, {D,E,F})}]">
    </arc>
    <arc id="[{C}--{({B,C}, {E})}]">
    </arc>
    <arc id="[{C}--{({C}, {E,F})}]">
